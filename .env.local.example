# Supabase Configuration (Required for user authentication and data storage)
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Required for server-side operations)
# IMPORTANT: This is a secret key - only use on server, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI Configuration (Required for AI-generated packing lists)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here
